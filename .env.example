# Supabase > Project settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo servidor. Nunca uses esta clave en variables NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=

# Mantiene los datos ficticios disponibles hasta conectar un proyecto Supabase.
# En producción debe ser false.
EMPATIA_DEMO_MODE=true
